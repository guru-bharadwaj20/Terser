# Row 11.3.7: terser-gpu, the quality-path rewriter on vLLM (CUDA base image, continuous batching).
# Serves an OpenAI-compatible API on :8000; terser-cpu calls it as quality.base_url.
#   docker build -f docker/Dockerfile.gpu -t terser-gpu .
# Needs an NVIDIA GPU (24 GB Ada class) and the NVIDIA container toolkit at run time.
FROM vllm/vllm-openai:v0.6.6

# The rewriter checkpoint (Phase 8, rows 8.3.3/8.3.4) is mounted at /models/rewriter, or set
# TERSER_REWRITER_MODEL to an HF repo id. bf16, short context: prompts are <= 256 tokens (C11.3).
ENV TERSER_REWRITER_MODEL=/models/rewriter \
    TERSER_SERVED_NAME=terser-rewriter \
    TERSER_MAX_MODEL_LEN=2048 \
    TERSER_GPU_MEM_UTIL=0.85

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=300s --retries=3 \
    CMD ["python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=4)"]
ENTRYPOINT ["/bin/sh", "-c", "exec python3 -m vllm.entrypoints.openai.api_server --host 0.0.0.0 --port 8000 --model \"$TERSER_REWRITER_MODEL\" --served-model-name \"$TERSER_SERVED_NAME\" --dtype bfloat16 --max-model-len \"$TERSER_MAX_MODEL_LEN\" --gpu-memory-utilization \"$TERSER_GPU_MEM_UTIL\""]
