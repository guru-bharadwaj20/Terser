# Row 11.3.7: terser-gpu, the quality-path rewriter on vLLM (CUDA base image, continuous batching).
# Serves an OpenAI-compatible API on :8000 (and vLLM's own Prometheus metrics at /metrics);
# terser-cpu calls it as quality.base_url.
#   docker build -f docker/Dockerfile.gpu -t terser-gpu .
# Building needs no GPU. Running needs an NVIDIA GPU (24 GB Ada class) and the NVIDIA container
# toolkit; never run it while a training job holds the card (docs/hardware.md, rule 3).
# vLLM 0.30.0 matches the GPU host's vLLM (reports/p2_gpu_smoke.md); the image ships its own
# CUDA runtime on an nvidia/cuda base.
FROM vllm/vllm-openai:v0.30.0

# Default: the Staging rewriter (terser-rewriter v6, 3B LoRA, reports/p11_registry.md). The
# checkpoints are not baked in: compose mounts ./models read-only at /models (dvc pull
# models/rewriter first) and the HF base model is downloaded into the hf-cache volume on first
# start. bf16, short context: prompts are <= 256 tokens (C11.3).
ENV TERSER_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct \
    TERSER_LORA_PATH=/models/rewriter/sft-qwen3b-lora \
    TERSER_REWRITER_MODEL= \
    TERSER_SERVED_NAME=terser-rewriter \
    TERSER_MAX_MODEL_LEN=2048 \
    TERSER_GPU_MEM_UTIL=0.85 \
    TERSER_MAX_LORA_RANK=16

COPY docker/gpu-entrypoint.sh /usr/local/bin/terser-gpu-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/terser-gpu-entrypoint \
    && chmod 0755 /usr/local/bin/terser-gpu-entrypoint

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
    CMD ["python3", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/health', timeout=4)"]
ENTRYPOINT ["/usr/local/bin/terser-gpu-entrypoint"]
