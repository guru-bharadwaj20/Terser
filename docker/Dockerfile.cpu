# Row 11.3.7: terser-cpu, the FastAPI service and fast path (span tagger + gate on ONNX Runtime).
# No GPU. The quality path is enabled by pointing quality.base_url at terser-gpu (compose.yaml).
#   docker build -f docker/Dockerfile.cpu -t terser-cpu .
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/cache/hf \
    TIKTOKEN_CACHE_DIR=/opt/cache/tiktoken \
    TERSER_CACHE=/tmp/terser-cache \
    TERSER_SERVING_CONFIG=/app/configs/serving/default.yaml

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs

# Install the package, then warm the target tokenizers so the container starts offline.
RUN pip install ".[serve]" \
    && python -c "from terser.tokenizers.count import count_tokens as c; [c('warm up', t) for t in ('gpt-4o', 'qwen2.5', 'llama-3.1')]" \
    && useradd --create-home --uid 10001 terser \
    && chown -R terser /opt/cache

USER terser
ENV HF_HUB_OFFLINE=1
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/healthz', timeout=2)"]
CMD ["uvicorn", "terser.serving.api:app", "--host", "0.0.0.0", "--port", "8080"]
