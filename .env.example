# Copy to .env and fill in. Never commit .env.
# Local open-model server (Ollama default; vLLM on the GPU machine: http://localhost:8000/v1)
# The RTX 4090 workers bind Ollama to 127.0.0.1, so forward the port and keep the URL as localhost:
#   ssh -f -N -L 127.0.0.1:11434:127.0.0.1:11434 ccbd@10.10.3.50   # worker-2
# See docs/hardware.md section 1.1. SSH credentials are shared out-of-band, never committed.
TERSER_LOCAL_LLM_URL=http://localhost:11434/v1
TERSER_LOCAL_LLM_KEY=
# Optional, not required by any phase:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
HF_HUB_DISABLE_SYMLINKS_WARNING=1
